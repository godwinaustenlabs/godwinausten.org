{
  "name": "godwinausten-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "dev:worker": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "dev:remote": "REMOTE_BINDINGS=1 next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "run-s test:unit test:worker",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "ci": "run-s check:resources typecheck lint format:check test",
    "ci:build": "run-s ci build:worker",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:version": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:whoami": "wrangler whoami",
    "cf:tail": "wrangler tail site --format pretty",
    "cf:versions": "wrangler versions list --name site",
    "cf:secrets": "wrangler secret list --name site",
    "check:resources": "node scripts/check-resources.mjs",
    "gen:figure": "node scripts/trace-figure.mjs",
    "gen:stills": "node scripts/generate-tile-stills.mjs",
    "gen:diagrams": "node scripts/generate-diagrams.mjs",
    "gen:placeholder-pdf": "node scripts/generate-placeholder-pdf.mjs",
    "gen:placeholder-video": "node scripts/generate-placeholder-video.mjs",
    "gen:photos": "node scripts/fetch-photos.mjs",
    "gen:favicon": "node scripts/generate-favicon.mjs",
    "db:sync:down": "node scripts/d1-sync.mjs pull",
    "db:sync:up": "node scripts/d1-sync.mjs push",
    "db:studio": "node scripts/d1-sync.mjs studio",
    "clean": "rm -rf .next .open-next .wrangler coverage playwright-report test-results tsconfig.tsbuildinfo",
    "reset": "npm run clean && rm -rf node_modules && npm ci"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "motion": "13.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@opennextjs/cloudflare": "1.20.4",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "27.4.0",
    "npm-run-all2": "9.0.3",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260828.1": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "unrs-resolver@1.12.2": true
  }
}
