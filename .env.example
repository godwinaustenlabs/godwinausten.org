# Build-time, PUBLIC values only. Anything with NEXT_PUBLIC_ is inlined into the
# client bundle — treat every value here as world-readable.
#
# Copy to `.env.local` for local overrides. Production values live in the `vars`
# block of wrangler.jsonc.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The origin `site-media` is served from. Leave unset to use the production
# host compiled into src/server/media.ts; set it to a different origin for a
# preview; set it to EMPTY to turn the origin off and send all media back
# through /api/media/[id] (the pre-origin behaviour).
# NEXT_PUBLIC_MEDIA_BASE_URL=
